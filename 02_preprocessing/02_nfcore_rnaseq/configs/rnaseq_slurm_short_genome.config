// NOTE: replace /path/to/your/project below with your actual project root.
// (Nextflow configs do not expand shell environment variables directly.)

workDir = '/path/to/your/project/Bulk_RNA/nextflow_work'
cleanup = false

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = '/path/to/your/project/Bulk_RNA/apptainer_cache'
    pullTimeout = '2h'
}

process {
    executor = 'slurm'
    queue = 'compute'

    cpus = 10
    memory = 60.GB
    time = 8.h

    errorStrategy = 'terminate'
    maxRetries = 1

    beforeScript = '''
        module purge
        module load apptainer/1.4.0-rc.1
    '''
}

timeline {
    enabled = true
    file = '/path/to/your/project/Bulk_RNA/results/results_short_read_genome/pipeline_info/timeline.html'
}

report {
    enabled = true
    file = '/path/to/your/project/Bulk_RNA/results/results_short_read_genome/pipeline_info/report.html'
}

trace {
    enabled = true
    file = '/path/to/your/project/Bulk_RNA/results/results_short_read_genome/pipeline_info/trace.txt'
}

dag {
    enabled = true
    file = '/path/to/your/project/Bulk_RNA/results/results_short_read_genome/pipeline_info/pipeline_dag.html'
}